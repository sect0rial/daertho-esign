# ---- required in production ---------------------------------------------------------------
ESIGN_ENV=production
# 64 random hex chars: openssl rand -hex 32. Signs sessions AND signing links:
# changing it logs everyone out and kills every outstanding signing link.
ESIGN_SECRET=
# Public address people reach the app on (used in emailed links and the seal).
ESIGN_PUBLIC_URL=https://sign.example.com
# Set to 1 when running behind a reverse proxy / load balancer that sets X-Forwarded-For.
ESIGN_TRUST_PROXY=1

# ---- storage -------------------------------------------------------------------------------
# Default: SQLite file in ESIGN_DATA_DIR. For Postgres: postgresql://user:pass@host:5432/db
ESIGN_DATABASE_URL=
ESIGN_DATA_DIR=/data
# Optional at-rest encryption of every stored file (Fernet key). Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK IT UP. Losing or changing it makes stored documents unreadable.
ESIGN_ENC_KEY=

# ---- email (optional) ----------------------------------------------------------------------
# Without SMTP, senders copy each signing link and share it themselves.
ESIGN_MAIL=0
ESIGN_SMTP_HOST=
ESIGN_SMTP_PORT=587
ESIGN_SMTP_TLS=starttls          # starttls | ssl | none
ESIGN_SMTP_USER=
ESIGN_SMTP_PASS=
ESIGN_SMTP_FROM=E-Sign <sign@example.com>
ESIGN_MAIL_DAILY_CAP=300

# ---- seal + timestamp ----------------------------------------------------------------------
# Leave empty to auto-create a self-signed root + seal certificate in $ESIGN_DATA_DIR/pki on first boot.
# Or bring your own (e.g. from scripts/esign_pki.py, or a certificate from a trust-list CA):
ESIGN_SEAL_P12=
ESIGN_SEAL_PASS=
# RFC 3161 timestamp servers, comma separated. "off" = seal without a timestamp.
ESIGN_TSA_URLS=

# ---- white-label ---------------------------------------------------------------------------
ESIGN_BRAND_NAME=Acme Sign
ESIGN_BRAND_LEGAL_NAME=Acme Ltd
ESIGN_BRAND_LOGO_URL=
ESIGN_BRAND_ACCENT=#111111
ESIGN_BRAND_ACCENT_INK=#ffffff
ESIGN_BRAND_BG=#f6f5f1
ESIGN_BRAND_INK=#111111
ESIGN_BRAND_FONT_HEAD=Fraunces
ESIGN_BRAND_FONT_BODY=Inter
ESIGN_BRAND_SUPPORT_EMAIL=
ESIGN_BRAND_HIDE_POWERED_BY=0

# ---- advanced (defaults are fine) ----------------------------------------------------------
# ESIGN_SESSION_DAYS=14            # how long a sign-in lasts
# ESIGN_DB_POOL=8                  # Postgres connection pool size
# ESIGN_SMTP_HELO=                 # hostname to announce to the SMTP server (some relays require it)
# ESIGN_PKI_AUTO=1                 # 0 = never auto-create a seal certificate on first boot
# ESIGN_SEAL_FPS=                  # SHA-256 fingerprints of retired seal certificates (after a rotation)
# ESIGN_TRUST_PEM=                 # extra trusted root certificate(s), PEM (e.g. your previous root)
# ESIGN_TSA_TIMEOUT=10             # seconds per timestamp server
# ESIGN_SOFFICE=                   # path to LibreOffice's soffice if not on PATH
# ESIGN_CONVERT_USER=esignconv     # unprivileged account LibreOffice runs as (empty = run as the API user)
# ESIGN_CONVERT_TMP=               # scratch directory for Word conversions
# ESIGN_CONVERT_MAX_AS=3221225472  # memory cap (bytes) for one conversion
